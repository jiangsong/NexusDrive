# Build and test output.
/cloudfs
/dist/
*.out
*.prof
*.test
/coverage.*

# Local runtime state and credentials. Examples under deploy/ remain tracked.
/config.yaml
/secrets/
*.db
*.db-shm
*.db-wal
*.sock
# Browser-tooling state: holds a live local auth token.
.gstack/
# Local end-to-end harness: a live daemon config, and the default secret store
# location for it (NewSecretStore falls back to <config dir>/secrets).
/.e2e-local/

# Editors and operating systems.
.DS_Store
.idea/
.vscode/
/cloudfs.exe
/cloudfs-desktop
